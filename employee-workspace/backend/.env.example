MONGO_URI=mongodb://127.0.0.1:27017/upsilon-platform
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development
PORT=5000

# Used only when running `npm run seed:admin` to create or reset the workspace admin.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Leave requests: 0 disables retrospective requests; default is 7.
PAST_LEAVE_LIMIT_DAYS=7
LEAVE_TIME_ZONE=Asia/Kolkata

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=replace-me
SMTP_PASS=replace-me
SMTP_FROM=no-reply@example.com
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
EMAIL_TO=hr@example.com

# Employee workspace URL used by leave-review links in notification emails.
WORKSPACE_URL=http://localhost:5173

# Optional override for the public HTTPS backend URL used by Manager email
# actions. Render deployments automatically use RENDER_EXTERNAL_URL.
BACKEND_PUBLIC_URL=http://localhost:5000
# Optional; secure email action links expire after 48 hours by default.
LEAVE_EMAIL_ACTION_TTL_HOURS=48

# Weekday daily summary schedule in LEAVE_TIME_ZONE (24-hour clock).
DAILY_LEAVE_SUMMARY_ENABLED=true
DAILY_LEAVE_SUMMARY_HOUR=9
DAILY_LEAVE_SUMMARY_MINUTE=0
DAILY_LEAVE_SUMMARY_CHECK_INTERVAL_MS=300000

CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me
